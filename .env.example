# Copy to .env and fill in. NEVER commit the real .env (SPEC §1.3).
# In deployment these become Lambda environment variables / AWS Secrets
# Manager entries -- see README "Configuration".

# ---------------------------------------------------------------------------
# CockroachDB Cloud
# ---------------------------------------------------------------------------
# Connection string from the CockroachDB Cloud console ("Connect" -> General
# connection string). Keep sslmode=verify-full.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:26257/DATABASE?sslmode=verify-full

# ---------------------------------------------------------------------------
# Provider selection -- lets the app run with no live services attached.
# fake    = deterministic local stand-in, no network, no credentials
# bedrock = Amazon Bedrock (requires AWS credentials + model access)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=fake
LLM_PROVIDER=fake

# ---------------------------------------------------------------------------
# AWS / Amazon Bedrock
# Only required when *_PROVIDER=bedrock. Leave blank for local dev.
# Credentials themselves are NOT read from here in deployment -- Lambda uses
# its execution role. These are for local development only.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL_ID=
BEDROCK_LLM_MODEL_ID=

# Dimension of the embedding vectors. MUST match the vector(N) column width in
# migrations/001_init.sql. Changing this requires a migration, not just an
# env edit. See NOTES.md for per-model dimensions.
EMBEDDING_DIMENSIONS=1024

# ---------------------------------------------------------------------------
# Agent guardrails (SPEC §5.4)
# ---------------------------------------------------------------------------
# Hard cap on model invocations per case, to bound cost and blast radius.
MAX_MODEL_CALLS_PER_CASE=3
# Milliseconds.
DB_TIMEOUT_MS=5000
MODEL_TIMEOUT_MS=30000
# Number of precedents to retrieve per case.
RETRIEVAL_TOP_K=5

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=info
