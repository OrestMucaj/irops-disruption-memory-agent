# Copy to .env and fill in. NEVER commit the real .env (SPEC §1.3).
# In deployment these become Lambda environment variables / AWS Secrets
# Manager entries -- see README "Configuration".

# ---------------------------------------------------------------------------
# CockroachDB Cloud
# ---------------------------------------------------------------------------
# Connection string from the CockroachDB Cloud console ("Connect" -> General
# connection string). Keep sslmode=verify-full.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:26257/DATABASE?sslmode=verify-full

# ---------------------------------------------------------------------------
# Provider selection -- lets the app run with no live services attached.
#
# EMBEDDING_PROVIDER: fake | bedrock
#   fake      deterministic feature-hashing stand-in. No network, no
#             credentials. Good enough that retrieval quality is developable
#             offline (see NOTES.md and the M2 numbers in SPEC.md).
#
# LLM_PROVIDER: fake | heuristic | bedrock
#   fake      returns a canned response. For tests that inject their own.
#   heuristic a hand-written decision tree, NOT a language model. Lets the
#             whole agent loop run offline and acts as a baseline for Bedrock
#             to beat. Never use it for the demo.
#   bedrock   the real path.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=fake
LLM_PROVIDER=fake

# ---------------------------------------------------------------------------
# AWS / Amazon Bedrock
# Only required when *_PROVIDER=bedrock. Leave blank for local dev.
# Credentials themselves are NOT read from here in deployment -- Lambda uses
# its execution role. These are for local development only.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1

# Verified against the AWS docs (NOTES.md §4.1). Confirm model access is
# enabled for this model in AWS_REGION before using it -- that is a common
# day-one blocker.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Left blank on purpose. The reasoning model has not been chosen yet: pick it
# from ListFoundationModels against the real account rather than from a docs
# page (NOTES.md §4.3 records AWS's own prose and code sample disagreeing on a
# model ID).
BEDROCK_LLM_MODEL_ID=

# Dimension of the embedding vectors. MUST match the VECTOR(N) column width in
# migrations/001_init.sql -- src/config.ts refuses to boot if they disagree.
# Changing this is a migration, not an env edit: every stored vector must be
# re-embedded, because vectors of different widths (or from different models)
# are not comparable.
# Titan Text Embeddings V2 accepts 1024 (default), 512, or 256.
EMBEDDING_DIMENSIONS=1024

# ---------------------------------------------------------------------------
# Agent guardrails (SPEC §5.4)
# ---------------------------------------------------------------------------
# Hard cap on model invocations per case, to bound cost and blast radius.
MAX_MODEL_CALLS_PER_CASE=3
# Milliseconds.
DB_TIMEOUT_MS=5000
MODEL_TIMEOUT_MS=30000
# Number of precedents to retrieve per case.
RETRIEVAL_TOP_K=5

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=info
