{
  "name": "irops-disruption-memory-agent",
  "version": "0.1.0",
  "private": true,
  "description": "An operational-memory agent for airline irregular-operations desks, backed by CockroachDB as a single system of record for both vectors and transactional state.",
  "license": "MIT",
  "author": "Orest Mucaj",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "verify:schema": "node --env-file=.env scripts/verify-schema.mjs",
    "check:db": "node --env-file=.env scripts/db-check.mjs",
    "check:bedrock": "node --env-file=.env scripts/bedrock-check.mjs",
    "seed": "npm run build && node --env-file=.env dist/seed/run.js",
    "check:retrieval": "npm run build && node --env-file=.env dist/seed/check-retrieval.js",
    "dev": "npm run build && node --env-file=.env dist/api/server.js",
    "agent": "npm run build && node --env-file=.env dist/agent/cli.js",
    "check:guardrails": "npm run build && node --env-file=.env dist/agent/check-guardrails.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.0.0",
    "pg": "^8.11.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.0.0"
  }
}
