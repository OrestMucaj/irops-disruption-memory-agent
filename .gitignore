# --- Secrets: never commit real values (SPEC §1.3) ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets.json

# --- Dependencies ---
node_modules/

# --- Build output ---
dist/
build/
*.tsbuildinfo

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-error.log*

# --- Test / coverage ---
coverage/
.nyc_output/

# Generated by scripts/deploy.ps1: contains the deployment's Lambda Function
# URL. Not a secret, but deployment-specific, so not source.
web/config.js

# --- Deploy / infra artifacts ---
.serverless/
cdk.out/
.aws-sam/
*.zip

# --- Editors & OS ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# --- Claude Code local state (machine-specific) ---
.claude/settings.local.json
